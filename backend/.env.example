GEMINI_API_KEY=your_key_here
# Your local PostgreSQL connection (keep your real password only in backend/.env, which is gitignored)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_erp_users

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_string

# The single admin account (there is no admin row in the users table)
ADMIN_EMAIL=admin@smarterp.com
ADMIN_PASSWORD=choose_a_strong_password

# Optional: comma-separated browser origins allowed to call the API
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
